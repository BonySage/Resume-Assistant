DATABASE_URL=postgres://resume_app:replace-with-app-password@localhost:5432/resume_assistant
MIGRATION_DATABASE_URL=postgres://postgres:replace-with-admin-password@localhost:5432/resume_assistant
APP_DB_PASSWORD=replace-with-app-password
JWT_SECRET=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_PARSE_MODEL=claude-haiku-5-5
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=false
PORT=3000

