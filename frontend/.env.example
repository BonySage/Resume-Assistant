# For local development, leave this UNSET (or use "/api").
# The Vite dev server proxies /api requests to localhost:3000 automatically
# (see vite.config.js), so you don't need a full URL — and setting one here
# bypasses the proxy and causes CORS errors.
#
# Only set the full URL for a hosted deployment (e.g. GitHub Pages):
# VITE_API_BASE_URL=https://your-backend-url.example.com/api
